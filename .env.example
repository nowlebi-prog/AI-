# 로그인 비밀번호 (필수). 길고 추측하기 어렵게 정해 주세요.
HUB_PASSWORD=

# 외부에서 접속하는 주소 (배포 시 필수). AI 연결(OAuth)과 캘린더 구독 주소에 쓰여요.
# 예: https://hub.example.com
HUB_PUBLIC_URL=

# 세션 서명 키 (선택). 비워 두면 처음 실행할 때 자동으로 만들어 DB에 저장해요.
HUB_SECRET=

# 데이터 폴더 (기본값 ./data). SQLite 파일(hub.db)과 매일 백업(backups/)이 여기에 생겨요.
HUB_DATA_DIR=./data

# 날짜 기준 시간대 (기본값 Asia/Seoul)
HUB_TZ=Asia/Seoul

# 노션 가져오기용 통합 토큰 (선택). 가져오기 화면에서 직접 입력해도 돼요.
NOTION_TOKEN=

PORT=3000

# ─── AI 실행 (전부 선택) ────────────────────────────────────────
# 비워 두면: 추천은 규칙으로 하고, 실행은 구독 중인 앱(ChatGPT·Claude·Grok·Muse)을 열어서 해요.
# 키를 넣으면: Hub 안에서 바로 API로 실행하고 결과의 [Hub 메모]를 자동 반영해요. API 사용료는 별도예요.

# Jev (TypeSafe) — 요청을 보고 어떤 AI·모델로 할지 판단
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# ChatGPT (OpenAI Responses API)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Claude (Anthropic Messages API)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Grok (xAI)
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1

# Muse (Meta Model API, OpenAI 호환 chat/completions). 키와 주소가 둘 다 있어야 켜져요.
META_API_KEY=
META_API_BASE_URL=

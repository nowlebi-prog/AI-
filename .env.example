# 로그인 비밀번호 (필수). 길고 추측하기 어렵게 정해 주세요.
HUB_PASSWORD=

# 외부에서 접속하는 주소 (배포 시 필수). AI 연결(OAuth)에 이 주소가 쓰여요.
# 예: https://hub.example.com
HUB_PUBLIC_URL=

# 세션 서명 키 (선택). 비워 두면 처음 실행할 때 자동으로 만들어 DB에 저장해요.
HUB_SECRET=

# 데이터 폴더 (기본값 ./data). SQLite 파일 하나(hub.db)가 여기에 생겨요.
HUB_DATA_DIR=./data

# 날짜 기준 시간대 (기본값 Asia/Seoul)
HUB_TZ=Asia/Seoul

# 노션 가져오기용 통합 토큰 (선택). 가져오기 화면에서 직접 입력해도 돼요.
NOTION_TOKEN=

PORT=3000
